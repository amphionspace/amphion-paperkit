# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.synctex(busy)
*.toc
*.lof
*.lot
*.nav
*.snm
*.vrb
*.run.xml
*.bcf
*-blx.bib
*.dvi
*.xdv
*.idx
*.ilg
*.ind
*.lol
# Cloud-sync duplicates ("main 2.tex", "main 2.synctex(busy)" etc.)
* 2.*
* 2

# Editor / OS junk
.DS_Store
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*~

# Python (in case you generate tables/plots from scripts)
__pycache__/
*.pyc
.venv/
venv/

# Generated PDF (default: not tracked; use git tag + zip for releases).
# Top-level main.pdf is left for backwards-compat during the egs migration;
# it will be removed once amphion-asr-2026 lands under egs/.
main.pdf
main.synctex.gz

# Per-egs build artifacts (PDFs are produced by CI / latexmk; not tracked).
egs/*/main.pdf
egs/*/main.synctex.gz

# Per-egs LaTeX intermediate files
egs/*/*.aux
egs/*/*.bbl
egs/*/*.blg
egs/*/*.fdb_latexmk
egs/*/*.fls
egs/*/*.log
egs/*/*.out
egs/*/*.toc
egs/*/*.lof
egs/*/*.lot
egs/*/*.synctex.gz
egs/*/*.synctex(busy)
egs/*/sections/*.aux

# Standalone figure intermediate files (the *.pdf is checked in for reproducibility)
figures/*.aux
figures/*.log
figures/*.synctex.gz
figures/*.synctex(busy)

# Reference PDFs (papers and dataset datasheets) — large; not tracked.
# INDEX.yaml (truth source) and INDEX.md (derived view) are tracked.
# Download via: python tools/fetch-refs.py egs/<slug>
egs/*/refs/notes/papers/*.pdf
egs/*/refs/datasets/*.pdf

# Overleaf-pack output: a flat, self-contained copy of egs/<slug>/ + template/
# produced by `tools/overleaf-pack.sh` (zip + folder). One-way mono-repo -> Overleaf,
# regenerated on demand; not tracked.
build/
